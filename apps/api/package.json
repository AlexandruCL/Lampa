{
  "name": "@lampa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-sites.ts",
    "glow:check": "tsx --env-file-if-exists=../../.env src/glow/check.ts",
    "place:reset": "tsx --env-file-if-exists=../../.env src/places/reset.ts"
  },
  "dependencies": {
    "@lampa/shared": "*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
