        {
          "id": "column",
          "q": {
            "ro": "Ce este coloana din mijlocul pieței?",
            "en": "What is the column in the middle of the square?"
          },
          "a": {
            "ro": "Este Coloana Sfintei Treimi, începută în 1740. I se spune și coloana ciumei: mulțumește pentru sfârșitul unei epidemii.",
            "en": "That is the Holy Trinity column, begun in 1740. People call it the plague column: it gives thanks for the end of an epidemic."
          }
        },
        {
          "id": "cathedrals",
          "q": {
            "ro": "De ce sunt două catedrale aici?",
            "en": "Why are there two cathedrals here?"
          },
          "a": {
            "ro": "Una este romano-catolică, cealaltă sârbă ortodoxă, și stau față în față peste piață. Vecini de credințe diferite împart piața aceasta de secole.",
            "en": "One is Roman Catholic, the other Serbian Orthodox, and they face each other across the square. Neighbours of different faiths have shared it for centuries."
          }
        },
        {
          "id": "languages",
          "q": {
            "ro": "De ce vorbiți atâtea limbi?",
            "en": "Why do you speak so many languages?"
          },
          "a": {
            "ro": "Pentru că Timișoara le-a vorbit mereu. Români, maghiari, germani, sârbi, evrei și mulți alții au vorbit peste piața aceasta, adesea toți deodată.",
            "en": "Because Timișoara always has. Romanians, Hungarians, Germans, Serbs, Jews and many others have talked across this square, often all at once."
          }
        }
