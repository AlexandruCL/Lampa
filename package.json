{
  "name": "lampa",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": "26.x" },
  "scripts": {
    "dev": "concurrently \"npm run dev -w @lampa/api\" \"npm run dev -w @lampa/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:reset": "npm run db:reset -w @lampa/api",
    "db:migrate": "npm run db:migrate -w @lampa/api",
    "db:seed": "npm run db:seed -w @lampa/api",
    "glow:check": "npm run glow:check -w @lampa/api",
    "agent:check": "tsx --env-file-if-exists=.env scripts/agent-check.ts",
    "simulate:crowd": "tsx scripts/simulate-crowd.ts",
    "publish:site": "tsx --env-file-if-exists=.env scripts/publish-site.ts"
  },
  "devDependencies": { "concurrently": "10.0.7" }
}
